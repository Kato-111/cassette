# Shared services
MONGO_URL=mongodb+srv://USER:PASSWORD@HOST/DATABASE
REDIS_URL=redis://127.0.0.1:6379

# Cloudflare R2 storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_TOKEN_VALUE= # Optional: R2 API token for administrative scripts
R2_ACCOUNT_ID=
# R2_ENDPOINT= # Optional: override the default Cloudflare R2 endpoint

# Web app
MUSIC_IMPORTER_URL=http://localhost:8787
IMPORTER_API_KEY=
# AUTH_PASSWORD= # Optional: password required for web access

# Music importer service
PORT=8787
IMAGE_TAG=latest
ALLOWED_ORIGINS=http://localhost:3000
TEMP_DIR=/tmp/import
MAX_CONCURRENT_IMPORTS=1
MAX_CONCURRENT_ITEMS=3
# SPOTIFY_CLIENT_ID= # Optional: enables Spotify imports
# SPOTIFY_CLIENT_SECRET=

# Mobile app (safe to expose to the client)
EXPO_PUBLIC_API_URL=https://cassetta.vercel.app

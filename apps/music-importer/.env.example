# Copy from the main music-player .env and fill in importer-specific values.

# Shared with music-player
MONGO_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ACCOUNT_ID=
# R2_ENDPOINT=

# Importer service
# Optional: Spotify Web API credentials for spotdl (uses spotdl defaults if omitted)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
IMPORTER_API_KEY=change-me-to-a-long-random-string
IMAGE_TAG=latest
PORT=8787
REDIS_URL=redis://127.0.0.1:6379
ALLOWED_ORIGINS=http://localhost:3000,https://cassetta.vercel.app
TEMP_DIR=/tmp/import
MAX_CONCURRENT_IMPORTS=1
MAX_CONCURRENT_ITEMS=3
